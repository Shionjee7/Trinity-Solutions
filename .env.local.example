# ---------------------------------------------------------------------------
# Trinity Solutions — environment variables (self-hosted Proxmox setup)
# Copy this file to .env.local and fill in real values before running the app.
# ---------------------------------------------------------------------------

# Public URL of your PocketBase instance (used by both server and browser)
NEXT_PUBLIC_PB_URL=https://api.taj-biz.com

# Internal URL the Next.js server uses to call itself (server-to-server only)
# Use the loopback address so traffic never leaves the container.
NEXT_INTERNAL_URL=http://localhost:3000

# PocketBase admin credentials (created during first-time setup at :8090/_/)
PB_ADMIN_EMAIL=admin@trinity.local
PB_ADMIN_PASSWORD=trinity2026

# Password for the /admin agent portal in the Next.js app
ADMIN_PASSWORD=trinity2026

# JWT signing secret — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic API key — only external service used
ANTHROPIC_API_KEY=sk-ant-...
